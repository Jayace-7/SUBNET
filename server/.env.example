PORT=4000
NODE_ENV=development

# Future service configuration placeholders
KEYCLOAK_URL=https://your-keycloak.example.com
TMDB_API_KEY=your_tmdb_api_key
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key
PAYMENTS_API_KEY=your_payments_api_key

# Security settings (optional, defaults are in src/config/env.js)
CLIENT_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=10kb
